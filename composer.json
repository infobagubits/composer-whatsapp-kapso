{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "infobagubits/whatsapp-kapso",
  "description": "Laravel integration for Kapso WhatsApp API",
  "keywords": [
    "laravel",
    "infobagubits",
    "laravel-kapso"
  ],
  "homepage": "https://github.com/infobagubits/whastapp-kapso",
  "license": "MIT",
  "authors": [
    {
      "name": "Integrations",
      "email": "info@bagubits.it",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^11.0 || ^12.0 || ^13.0",
    "guzzlehttp/guzzle": "^7.8.2 || ^8.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.29",
    "laravel/pao": "^1.0",
    "orchestra/testbench": "^10.0||^11.0",
    "pestphp/pest": "^4.6||^5.0",
    "pestphp/pest-plugin-laravel": "^4.1||^5.0",
    "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Integrations\\Kapso\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Integrations\\Kapso\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=512M"
    ],
    "test:types": [
      "@php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Integrations\\Kapso\\KapsoServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
